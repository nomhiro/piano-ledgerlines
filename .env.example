# Local development is explicit: no Azure credentials are required.
LEDGERLINES_AUTH_MODE=development
LEDGERLINES_DEV_USER_ID=usr_local_dev
LEDGERLINES_REPOSITORY=local
LEDGERLINES_STORAGE=local
LEDGERLINES_QUEUE=local
LEDGERLINES_DATA_DIR=.data

# Production: set LEDGERLINES_AUTH_MODE=entra and provide the three values below.
# ENTRA_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# ENTRA_AUDIENCE=api://<application-id>
# ENTRA_JWKS_URL=https://login.microsoftonline.com/<tenant>/discovery/v2.0/keys

# Azure backends use DefaultAzureCredential / Managed Identity.
# AZURE_COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
# AZURE_COSMOS_DATABASE=ledgerlines
# AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
# AZURE_STORAGE_ACCOUNT_NAME=<account>
# AZURE_ANALYSIS_QUEUE=analysis-jobs
# LEDGERLINES_FOUNDRY_ENABLED=true
# AZURE_FOUNDRY_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_FOUNDRY_DEPLOYMENT=<deployment-name>
# AZURE_FOUNDRY_MODEL=<model-version>
# AZURE_FOUNDRY_API_VERSION=2024-10-21
# LEDGERLINES_COACH_PROMPT_VERSION=coach-v1
# LEDGERLINES_PIPELINE_VERSION=pipeline-v1
# LEDGERLINES_TELEMETRY=console

# Classroom Stripe billing (server-only; never use NEXT_PUBLIC_ for these values).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CLASSROOM_BASE_PRICE_ID=price_...
# STRIPE_CLASSROOM_STUDENT_PRICE_ID=price_...
# LEDGERLINES_APP_BASE_URL=http://localhost:3000
# LEDGERLINES_INVITATION_TOKEN_SECRET=replace-with-a-random-32-byte-secret
# LEDGERLINES_INVITATION_TTL_DAYS=7
# LEDGERLINES_INVITE_RATE_LIMIT=20
# LEDGERLINES_INVITE_RATE_WINDOW_MINUTES=60

# Classroom invitation email. Development defaults to an in-memory sender.
# Use `console` only when a delivery-safe summary in local logs is useful.
# Production must use `azure` and both Azure values are required.
# LEDGERLINES_EMAIL_BACKEND=memory
# AZURE_COMMUNICATION_EMAIL_ENDPOINT=https://<communication-service>.communication.azure.com
# AZURE_COMMUNICATION_EMAIL_SENDER_ADDRESS=DoNotReply@<verified-email-domain>
# AZURE_EMAIL_MANAGED_IDENTITY_CLIENT_ID=<dedicated-email-sender-managed-identity-client-id>

# PDF楽譜のOMR（印刷されたPDFのみ）。Audiveris実行ファイルへのコマンドを指定できます。
# AUDIVERIS_COMMAND=audiveris
# AUDIVERIS_TIMEOUT_SECONDS=300
