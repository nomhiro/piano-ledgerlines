  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:production": "tsx --test scripts/production-check.ts",
    "test:unit": "tsx --test src/components/empty-takes.test.ts src/components/score-overlay.test.ts src/components/take-navigation.test.ts src/components/song-status.test.ts src/components/measure-selection.test.ts src/lib/api/client.test.ts src/lib/dashboard.test.ts src/lib/score-progress.test.ts src/lib/real-history.test.ts src/lib/server/deterministic-analysis.test.ts src/lib/server/omr-queue.test.ts src/lib/server/take-state.test.ts src/app/songs/new/upload-target.test.ts",
    "test:classroom": "tsx --test --test-concurrency=1 src/lib/server/classroom-invitations.test.ts src/lib/server/account.test.ts src/app/classroom-invitations/accept/invitation-client.test.ts",
    "test:infra": "tsx --test infra/acs-email-identity.test.ts",
    "azure:up": "docker compose -f docker-compose.azure-local.yml up -d",
    "azure:down": "docker compose -f docker-compose.azure-local.yml down",
    "azure:health": "tsx scripts/azure-local.ts health",
    "azure:init": "tsx scripts/azure-local.ts init",
    "azure:check": "tsx scripts/azure-local.ts check",
    "azure:start": "tsx scripts/azure-local.ts start",
    "azure:cloud:check": "tsx scripts/azure-cloud.ts check",
    "azure:cloud:init": "tsx scripts/azure-cloud.ts init",
    "azure:cloud:start": "tsx scripts/azure-cloud.ts start",
    "test:azure-local": "tsx scripts/azure-local-smoke.ts"
  },
  "dependencies": {
    "@azure/communication-email": "^1.1.0",
    "@azure/cosmos": "^4.10.0",
