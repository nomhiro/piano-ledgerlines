    "@azure/storage-queue": "^12.31.0",
    "@tonejs/midi": "^2.0.28",
    "jose": "^6.2.4",
    "lucide-react": "^1.26.0",
    "next": "16.2.11",
    "opensheetmusicdisplay": "^2.1.0",
    "proper-lockfile": "^4.1.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.0",
    "stripe": "^22.5.0",
    "tone": "^15.1.22",
