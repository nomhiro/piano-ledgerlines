# Copy to .env.local.azure (never commit that file) and run npm run azure:start.
NODE_ENV=development
LEDGERLINES_AUTH_MODE=development
LEDGERLINES_DEV_USER_ID=usr_local_azure
LEDGERLINES_REPOSITORY=azure
LEDGERLINES_STORAGE=azure
LEDGERLINES_QUEUE=azure
LEDGERLINES_AZURE_EMULATOR=true
# `npm run azure:up` は解析ワーカー（worker/cloud_worker.py, worker/Dockerfile）も
# コンテナとして起動するため、Queueに積んだジョブは本物の採譜・アライメント・
# スコアリングで処理される。ここは false のままにしておくこと。
# true に戻すのは、ワーカーコンテナを起動せずUI側だけを触りたい場合や、
# 実推論の待ち時間（CPU推論、初回はモデルダウンロードもある）を避けたい場合など、
# queue.ts の runDeterministicAnalysis による固定値（overallScore 79）のスタブで
# 十分なときだけ。
LEDGERLINES_DETERMINISTIC_ANALYSIS=false
LEDGERLINES_FOUNDRY_ENABLED=false
LEDGERLINES_TELEMETRY=console

AZURE_COSMOS_ENDPOINT=https://localhost:8081
AZURE_COSMOS_KEY=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw==
AZURE_COSMOS_DATABASE=ledgerlines
AZURE_COSMOS_SONGS_CONTAINER=songs
AZURE_COSMOS_TAKES_CONTAINER=takes

AZURE_STORAGE_ACCOUNT_NAME=devstoreaccount1
# Azurite/レガシーStorage Emulatorの唯一の既知アカウントキー（Microsoft Learn
# 「Configure a connection string for Azurite」に記載）。以前ここにあった値は
# 桁数もパターンも異なる誤った文字列で、実際にAzuriteへ接続すると
# AuthenticationFailed(403)になっていた（このコメントを書いた時点で実機確認済み）。
AZURE_STORAGE_ACCOUNT_KEY=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==
AZURE_STORAGE_ACCOUNT_URL=http://127.0.0.1:10000/devstoreaccount1
AZURE_STORAGE_QUEUE_URL=http://127.0.0.1:10001/devstoreaccount1
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;QueueEndpoint=http://127.0.0.1:10001/devstoreaccount1;
AZURE_STORAGE_SCORES_CONTAINER=scores
AZURE_STORAGE_AUDIO_CONTAINER=audio
AZURE_STORAGE_DERIVED_CONTAINER=derived
AZURE_ANALYSIS_QUEUE=analysis-jobs
AZURE_SCORE_QUEUE=score-jobs
AZURE_SAS_LIFETIME_SECONDS=900

# Local emulator profile uses the in-memory sender by default.
# LEDGERLINES_EMAIL_BACKEND=memory
# AZURE_COMMUNICATION_EMAIL_ENDPOINT=https://<communication-service>.communication.azure.com
# AZURE_COMMUNICATION_EMAIL_SENDER_ADDRESS=DoNotReply@<verified-email-domain>
# AZURE_EMAIL_MANAGED_IDENTITY_CLIENT_ID=<dedicated-email-sender-managed-identity-client-id>
