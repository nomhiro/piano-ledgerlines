# Cloud-backed local profile. Copy to .env.local.azure-cloud and never commit
# the copy. The script reads endpoint outputs from the selected azd environment.
NODE_ENV=development
AZD_ENV_NAME=ledgerlines-dev
LEDGERLINES_AZURE_CLOUD=true
AZURE_TOKEN_CREDENTIALS=AzureCliCredential
LEDGERLINES_AUTH_MODE=development
LEDGERLINES_DEV_USER_ID=usr_local_azure_cloud_dev
LEDGERLINES_REPOSITORY=azure
LEDGERLINES_STORAGE=azure
LEDGERLINES_QUEUE=azure
LEDGERLINES_DETERMINISTIC_ANALYSIS=false
LEDGERLINES_TELEMETRY=console

# These values are populated from `azd env get-values` and the latest
# read-only `az deployment group list` outputs.
# You may set them explicitly to non-secret deployment outputs when azd does
# not expose the outputs in your environment:
# AZURE_COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
# AZURE_COSMOS_DATABASE=ledgerlines
# AZURE_STORAGE_ACCOUNT_NAME=<account>
# AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
# AZURE_STORAGE_QUEUE_URL=https://<account>.queue.core.windows.net
# AZURE_ANALYSIS_QUEUE=analysis-jobs
# AZURE_STORAGE_SCORES_CONTAINER=scores
# AZURE_STORAGE_AUDIO_CONTAINER=audio
# AZURE_STORAGE_DERIVED_CONTAINER=derived
# LEDGERLINES_FOUNDRY_ENABLED=true
# AZURE_FOUNDRY_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_FOUNDRY_DEPLOYMENT=coach
# AZURE_FOUNDRY_MODEL=gpt-4o-mini
# AZURE_FOUNDRY_API_VERSION=2024-10-21

# Classroom invitation email. `azure` requires the ACS endpoint and a sender
# address from a verified ACS Email domain. Do not put access keys here.
# LEDGERLINES_EMAIL_BACKEND=azure
# AZURE_COMMUNICATION_EMAIL_ENDPOINT=https://<communication-service>.communication.azure.com
# AZURE_COMMUNICATION_EMAIL_SENDER_ADDRESS=DoNotReply@<verified-email-domain>
# AZURE_EMAIL_MANAGED_IDENTITY_CLIENT_ID=<dedicated-email-sender-managed-identity-client-id>
