# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.local.azure.example
!.env.local.azure-cloud.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# M5ローカル開発用データストア（曲/テイクJSON・音声・解析中間ファイル）
# 本番ではCosmos DB/Blob Storageに置き換わるため、ローカル実行の作業データはコミットしない。
/.data/

# Pythonワーカーのローカル実行時生成物・venv（PoC同様に .gitignore 対象）
worker/.venv/
worker/**/__pycache__/
worker/*.wav
